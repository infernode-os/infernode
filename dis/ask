#!/dis/sh.dis
# ask [-ns] [-m model] [system] - put the text on standard input to a
# language model, with the instructions in the file system, and print
# its answer; with -n, print only the model's name; with -s, only the
# settings it is asked with, one line of attr=value words
# (temperature=... maxtokens=... thinking=..., each unknown for a
# command).  A tool that wants a model's answer pipes to this, so that
# none of them knows which model it has: the model is whatever is
# mounted at /mnt/llm (llmsrv, with the backend and key it was started
# with, or a model mounted from another machine), a session cloned,
# asked and closed.  $llm, if it is set and not llm, is a command
# instead: it is given the instructions, a blank line and the question
# on its standard input, and what it prints is the answer; where it has
# a word {system}, the instructions are put there, one argument, and
# only the question goes on its input:
#
#	os claude -p --tools '' --system-prompt {system}
#
# for the host's Claude CLI as a plain model.  A command beginning os
# runs on the host, outside the caller's name space.
load std

fn usage {
	echo 'usage: ask [-ns] [-m model] [system]' >[1=2]
	raise fail:usage
}

model=()
n=()
settings=()
args=$*
while {~ ${hd $args} -*} {
	opt=${hd $args}
	args=${tl $args}
	if {~ $opt -n} {
		n=1
	} {~ $opt -s} {
		settings=1
	} {~ $opt -m} {
		if {~ $#args 0} {usage}
		model=${hd $args}
		args=${tl $args}
	} {
		usage
	}
}
if {! ~ $#args 0 1} {usage}
system=$args
if {! ~ $#system 0} {
	if {! ftest -f $system} {
		echo 'ask: no file '^$system >[1=2]
		raise 'fail:no file'
	}
}
way=llm
if {! ~ $#llm 0} {
	if {! ~ $"llm '' llm} {
		way=command
	}
}
if {~ $way llm} {
	if {! ftest -f /mnt/llm/new} {
		echo 'ask: no model at /mnt/llm: start llmsrv, or mount one, or set llm to a command' >[1=2]
		raise 'fail:no llm'
	}
	id=`{cat /mnt/llm/new}
	s=/mnt/llm/$id
	if {! ~ $#model 0} {
		echo $model > $s/model
	}
	# a session's default answer is short: a logic file can be longer
	if {ftest -f $s/maxtokens} {
		echo 8192 > $s/maxtokens
	}
	if {~ $#n 1} {
		# a server started with no model names none
		mn=`{cat $s/model}
		if {~ $#mn 0} {
			mn=unknown
		}
		echo $mn
	} {~ $#settings 1} {
		t=`{cat $s/temperature}
		k=`{cat $s/maxtokens}
		h=`{cat $s/thinking}
		echo 'temperature='^$"t 'maxtokens='^$"k 'thinking='^$"h
	} {
		if {! ~ $#system 0} {
			cat $system > $s/system
		}
		cat > $s/ask
		cat $s/ask
	}
	echo close > $s/ctl
} {
	if {~ $#n 1} {
		echo $"llm
	} {~ $#settings 1} {
		echo 'temperature=unknown maxtokens=unknown thinking=unknown'
	} {~ $"llm *'{system}'*} {
		# the instructions as the command's own argument, its system
		# prompt; the question alone on its standard input.  The
		# command is the shell's to parse, {system} a variable in it
		asksystem=''
		if {! ~ $#system 0} {
			asksystem="{cat $system}
		}
		sh -c "{echo $"llm | sed 's/\{system\}/$asksystem/g'}
	} {
		{
			if {! ~ $#system 0} {
				cat $system
				echo
			}
			cat
		} | sh -c $"llm
	}
}
