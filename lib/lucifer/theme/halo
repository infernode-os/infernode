xenith-bord-text-0 E3E3E3	# body frame and scroll bar (thumb is the body)
xenith-bord-col-0 D6D6D6	# between columns
xenith-bord-row-0 D6D6D6
xenith-bg-tag-1 E1EBFA		# tag selection
xenith-bg-text-1 D5E3F8		# body selection
xenith-fg-text-1 2B2B2B
xenith-fg-tag-1 2B2B2B
