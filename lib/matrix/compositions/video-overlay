# video-overlay — live video with ML-style annotations, composed.
#
# One video-overlay leaf: the vid9p stream at the mount with its layers
# (layers(2), #1095) drawn over it: each file in the feed's layer/
# directory is a layer of records (box, line, text, point; a detection
# from vision(4) is a box), stacked in the union's order, so a layer is
# added with bind -a (above) or bind -b (below) and taken away with
# unmount, while the pane runs:
#
#     bind -a /mnt/vision/1/layer /mnt/video/0/layer
#
# This is the drone/TAK product shape end to end: URL -> vdec -> 9P ->
# pane, with inference as just another 9P mount beside the stream.
#
#     wm/matrix -g 800x600 /lib/matrix/compositions/video-overlay
# (tools/demo/demo-overlay.sh is that, self-contained, with a synthetic tracker)

layout vsplit 88 12

top    video-overlay /mnt/video/0
bottom video-ctl     /mnt/video/0
