# shell functions for starting inferno services
load std

fn srv {
	if {! ftest -f /net/cs} {
		srv.cs
	}
	srv.styx
}

fn srv.cs {
	ndb/dns -r
	ndb/cs
}

fn srv.styx {
	listen tcp!*!styx {export /&}
}

fn srv.auth {
	listen -A tcp!*!inflogin auth/logind
}

# signer(8)'s operator-approved enrolment, for a realm that wants it:
# not started by srv.auth (no client here uses it, and its
# certificates never expire)
fn srv.signer {
	listen -A tcp!*!infsigner auth/signer
	listen -A tcp!*!infcsigner auth/countersigner
}
