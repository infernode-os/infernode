.TH BRICK 1
.SH NAME
brick \- pair with, configure and mount a styxbrick
.SH SYNOPSIS
.B brick key
[
.B -d
.I keydir
]
.br
.B brick pair
[
.B -d
.I keydir
]
.I usbmnt
.br
.B brick wifi
.I usbmnt
.br
.B brick mount
[
.B -abu
] [
.B -d
.I keydir
]
.I addr
.I mountpoint
.br
.B brick d2
[
.B -u
] [
.B -d
.I keydir
] [
