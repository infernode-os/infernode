.TH MKFN 1
.SH NAME
mkfn \- describe a font for troff
.SH SYNOPSIS
.B mkfn
[
.B -a
|
.B -o
] [
.B -s
] [
.B -b
] [
.B -l
] [
.B -n
] [
.B -g
] [
.B -w
] [
.B -c
] [
.BI -p " name"
] [
.BI -t " name"
] [
