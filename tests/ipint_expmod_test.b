implement IPintExpmodTest;

#
# IPint.expmod (libinterp/ipint.c over libmp's mpexp): known answers from
# Python's pow, for the Montgomery path (an odd modulus) and the general
# one (an even modulus); zero exponents and a modulus of 1; a
# Diffie-Hellman agreement in RFC 3526's 2048-bit group, as login(2),
# logind and secstore make; times for 2048 and 4096 bits (shown with -v).
# tests/host/mpexp_test.sh checks mpexp itself on the host, constant time
# included.
#

include "sys.m";
	sys: Sys;

include "draw.m";

include "keyring.m";
	kr: Keyring;
	IPint: import kr;

include "testing.m";
	testing: Testing;
	T: import testing;

IPintExpmodTest: module
{
	init: fn(nil: ref Draw->Context, args: list of string);
};

SRCFILE: con "/tests/ipint_expmod_test.b";

passed := 0;
failed := 0;
skipped := 0;

run(name: string, testfn: ref fn(t: ref T))
{
	t := testing->newTsrc(name, SRCFILE);
	{
		testfn(t);
	} exception {
	"fail:fatal" =>
		;
	"fail:skip" =>
		;
	* =>
		t.failed = 1;
	}

	if(testing->done(t))
		passed++;
	else if(t.skipped)
		skipped++;
	else
		failed++;
}

# (what, base, exponent, modulus, base^exponent mod modulus), in hex
vectors := array[] of {
	("DH 2048 (RFC 3526 group 14), g=2",
		"2",
		"",
		"",
		""),
	("DH 2048, a 256-bit exponent",
		"",
		"853696d862e8e8400e5b8eecd05f92278abf4d8b49ba508034c6460cb95e2d97",
		"",
		""),
	("DH 4096 (RFC 3526 group 16)",
		"2",
		"",
		"",
		""),
	("odd 1024-bit modulus, base above it",
		"25919961e5446c074e6989aa88548c327643c3ecde3a9a11e4e145dfd8830c2af792e854b573872fe8ccd676e7a2bb56a7a089bf37356a0d674153189c9993f36a32b4d28180991cfd1746f5f2e0bd301982c191831bb87e9af920cb39c031f18274288cdbf9693ace0d0f0e23669ec576d41f4f43af56f2367e0a2250095793e5037748916131cdd10",
		"15e1522a969f530ef9cc6bc54ca55cb270dcafd5d96714c9ef0012c3a4f60008ca2a79d0b2850565df7e4ef5c14c360fa11edefd76066f4c1977718d195ee169167d49b82dba3982018a9518fa1403c39c7a84e03dd4f7e641b29a977ee7fbd88bdf39a830193902afe0e3921fde4f7d0fbea40545ac340f9df8a615e3c5d442f9",
		"96679a477dc9a13025d42965ed1bbb88d485484665aab74dc7db7d4dabac91d2ebce3390a85e760f124833c42f17ecbe65ad5e87ae815177c9dcaf8ddeb4524f7a3e60f06d7ee93bbf4d39156414da62e7c17bc16ad6716519d149c09e9abcb5e57f1a176acd74b31cc31d9c1116387b4d0796a3b810ec48d7e977ee45555f77",
		"7dfc1fd9cffd7c4e42f61d31a46c108658106fdc3cb646071e192104a52bc73227b9c5a5feaf968a9eab57728bcb04d8cb5000ed8d3ac659f7045e0b829aca8dc1220bb2be4a7c1a6feb3613d96992905d3c7eb8fdaedf832d8ba80a4eb1cc33da5797a75ee4e231f70ad3628a0c024b5bad9604912e5f9648af4fa3673514f7"),
	("odd 1031-bit modulus, exponent 65537",
		"d4d2cf8609b19ea4b350fd6f86b165a7633dd846b4a0a4e9651a5cd240da7ab46958b7be03df76b1e42b218dc3428363c683d6eb324d72e526aa1cad8e278fb1918f34601c9a85a7494a7e54a956b4e37ea1f013f5fdfab83ca0e6c5e5b2412ab8cd6a94f1f13bfca33267d120bfe0ac36a3b820ef9094a7f5517837d3",
		"10001",
		"5b42aafd9bad4abf86db1a2e4d13db1dd243e0116289bec6faf2d618fc15a9b5b4a0cde23c9c390071ea15675e8334f7b99ec1da474c4e56c1c846e65867600c5a71a9c2687cba87cbce5ae4d2e61ae4d904e4b4aeba2a5d18a9e310b9bd259dc1c75833ded208ddd66f8e7aad941f66348719c8a8f8c09366cb63ab44665eed8d",
		"4a89d1cb81b3d703e8beb190a39520ab1955cad3cc9402cf54968b608a9491fdd0c89465dd8da0c0f58d083b3a979d202611ac5a9c3ea0c89aae01a7eed2e3b2424b9cba09decc6ca7b22ffdd09645d139e1c07f5b61b30ef0f44060142faf112928dbb97ae64abdf056e59d3308f7458ae651915f2d39761bf0bddb4d4f14fdac"),
	("even 512-bit modulus (general path)",
		"d7c32503f2b9406602bcc8a02390f40b10643f1a39f71577a5de42dbab6524df6feb9b78fe37bb3fce260ff0b56ae8ca8f73ebee102b6f5f5af5d5c6a6505704",
		"abd2d716b23fb534a21a7760fcd815eb3a3d30dbe7e3269c07130656f030d06ba94b813f228c213a56256b0b1a53964b59db8c5d6502e2cfccb779531b441656",
		"eb615ea44f51385ab00119670ddd5714edf0627acf586d9b9e166f8d729afae78069ddb5ea61133baefe4944b170cfe3162b256dfe70fd99b392416cba34dc64",
		"5f991495f3eadffceafe0ff48c20d92b9aba2f24fcfdbd03ed1c820ced30ebd389dd40b42f77c7e558ea548ec54e7dd3ca1393187dbcaeefd65a8a4f1ae63770"),
	("base 0",
		"0",
		"3039",
		"",
		"0"),
	("base m-1, odd exponent",
		"",
		"3",
		"",
		""),
	("modulus 1",
		"3039",
		"1a85",
		"1",
		"0"),
	("modulus 3",
		"a",
		"100000000000000000000000000000000000000000000000001",
		"3",
		"1")
};

hex(s: string): ref IPint
{
	return IPint.strtoip(s, 16);
}

testKnownAnswers(t: ref T)
{
	for(i := 0; i < len vectors; i++){
		(what, b, e, m, r) := vectors[i];
		got := hex(b).expmod(hex(e), hex(m));
		if(got == nil){
			t.error(what+": nil");
			continue;
		}
		if(!got.eq(hex(r)))
			t.error(what+": got "+got.iptostr(16));
		# negative base through the general path: (-b)^e = (m-b)^e mod m
		if(hex(b).cmp(IPint.inttoip(0)) > 0){
			neg := hex(b).neg().expmod(hex(e), hex(m));
			pos := hex(m).sub(hex(b).mod(hex(m))).expmod(hex(e), hex(m));
			if(!neg.eq(pos))
				t.error(what+": negative base");
		}
	}
}

testZeroExponent(t: ref T)
{
	zero := IPint.inttoip(0);
	one := IPint.inttoip(1);
	t.assert(IPint.inttoip(7).expmod(zero, IPint.inttoip(13)).eq(one), "7^0 mod 13");
	# as mpexp always has: 1, not 1 mod m
	t.assert(IPint.inttoip(7).expmod(zero, one).eq(one), "7^0 mod 1");
	t.assert(IPint.inttoip(3).expmod(IPint.inttoip(5), nil).eq(IPint.inttoip(243)), "3^5, no modulus");
}

P14: con "";

testAgreement(t: ref T)
{
	p := hex(P14);
	g := IPint.inttoip(2);
	for(i := 0; i < 4; i++){
		x := IPint.random(2047, 2047);
		y := IPint.random(2047, 2047);
		gx := g.expmod(x, p);
		gy := g.expmod(y, p);
		t.assert(gy.expmod(x, p).eq(gx.expmod(y, p)), "g^xy = g^yx");
	}
}

testTiming(t: ref T)
{
	m := array[] of {(2048, 20), (4096, 4)};
	for(i := 0; i < len m; i++){
		(bits, n) := m[i];
		mod := IPint.random(bits, bits);
		mod = mod.ori(IPint.inttoip(1));
		b := IPint.random(bits-1, bits-1);
		e := IPint.random(bits, bits);
		t0 := sys->millisec();
		for(j := 0; j < n; j++)
			b.expmod(e, mod);
		ms := real (sys->millisec() - t0) / real n;
		t.log(sys->sprint("%d-bit modulus and exponent: %.2f ms", bits, ms));
	}
}

init(nil: ref Draw->Context, args: list of string)
{
	sys = load Sys Sys->PATH;
	kr = load Keyring Keyring->PATH;
	testing = load Testing Testing->PATH;

	if(testing == nil) {
		sys->fprint(sys->fildes(2), "cannot load testing module: %r\n");
		raise "fail:cannot load testing";
	}
	if(kr == nil) {
		sys->fprint(sys->fildes(2), "cannot load keyring: %r\n");
		raise "fail:cannot load keyring";
	}

	testing->init();

	for(a := args; a != nil; a = tl a) {
		if(hd a == "-v")
			testing->verbose(1);
	}

	run("KnownAnswers", testKnownAnswers);
	run("ZeroExponent", testZeroExponent);
	run("Agreement", testAgreement);
	run("Timing", testTiming);

	if(testing->summary(passed, failed, skipped) > 0)
		raise "fail:tests failed";
}
