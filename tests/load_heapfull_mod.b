implement LoadHeapfullMod;

#
# A module with no data (no strings, no globals), so that loading it asks
# the Dis heap for nothing until its Modlink is made, and with enough
# instructions that a copy of it left loaded is seen in the kernel's pool.
# tests/load_heapfull.b loads it with the heap full.
#

LoadHeapfullMod: module
{
	f:	fn(a: int): int;
};

