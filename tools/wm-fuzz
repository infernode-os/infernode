#!/bin/bash
#
# wm-fuzz — grind a wm/wm application with random use until it breaks.
#
#	wm-fuzz [-a editor|shell] [-n runs] [-s seed] [-t secs] [-j jobs]
#		[-i] [-k]
#
# Each run starts wm/wm (the SDL dummy driver) with the application in
# its one window, and tests/wmfuzz.b: a storm of random clicks, drags,
# chords, menus, wheel and scroll-bar use and typing through wm/wm's
# /chan/uitest, while for the editor a client changes its text through
# /edit and the Veltro editor tool's files, as an agent does.  Then it
# checks the application still answers: the editor's text reads back
# whole, undo all the way back and redo all the way forward give it
# back, and saveas writes it; the shell runs a command typed and shows
# its output.
#
#	-a	the application: editor (wm/editor) or shell (wm/shell)
#	-n	runs (8); their seeds are seed, seed+1, ...
#	-s	the first seed (the time)
#	-t	seconds of input in each run (30)
#	-j	runs at once (the CPUs)
#	-i	the interpreter (emu -c0), whose stacks say where; the JIT
#		(-c1) otherwise
#	-k	keep the run's directory and log even when it passed
#
# Each run's output is in $ROOT/tmp/wm-fuzz/logs/<app>-<seed>.log; a run
# that failed keeps it, with the stacks of the procs when it hung mapped
# to source lines.  The emulator's root is a copy of what the
# applications need (tools/fuzz-common.sh), made afresh for each
# wm-fuzz under $ROOT/tmp/wm-fuzz/root.<pid> (two at once do not share
# one), so what is saved or typed into the shell is never the tree's;
# it is kept when a run failed, or with -k.  A run in which the application
# was asked to exit (its menu's exit) passes, and says so.  Exit status
# 1 if any run failed: froze (HUNG, STUCK: the shell answered only when
# a new one was started), lost a proc (BROKEN), left (no outcome), or
# lost text (DATA).  Shells started again while it was used (two
# Ctrl-Cs that found it stuck) are counted in the log.
#
# Needs the SDL GUI emulator and the tests built (cd tests; mk install).

ROOT="$(cd "$(dirname "$0")/.." && pwd)"
. "$ROOT/tests/host/common.sh"
. "$ROOT/tools/fuzz-common.sh"
cd "$ROOT"

app=editor
runs=8
seed=$(date +%s)
secs=30
jobs=$( (nproc || sysctl -n hw.ncpu) 2>/dev/null || echo 2)
flag=-c1
keep=0
while getopts a:n:s:t:j:ik c; do
	case $c in
	a)	app=$OPTARG ;;
	n)	runs=$OPTARG ;;
	s)	seed=$OPTARG ;;
	t)	secs=$OPTARG ;;
	j)	jobs=$OPTARG ;;
	i)	flag=-c0 ;;
	k)	keep=1 ;;
	*)	sed -n '3,/^$/s/^# \{0,1\}//p' "$0" >&2; exit 2 ;;
	esac
done
case $app in
editor|shell)	;;
*)	echo "wm-fuzz: -a editor or -a shell" >&2; exit 2 ;;
esac

[ -x "$EMU" ] || { echo "wm-fuzz: no emulator at $EMU" >&2; exit 2; }
if command -v nm >/dev/null 2>&1 && ! nm "$EMU" 2>/dev/null | grep -q sdl3_mainloop; then
	echo "wm-fuzz: $EMU is a headless build; the SDL GUI emulator is needed" >&2
	exit 2
fi
[ -f dis/tests/wmfuzz.dis ] || { echo "wm-fuzz: build the tests first (cd tests; mk install)" >&2; exit 2; }

top=$ROOT/tmp/wm-fuzz
logs=$top/logs
mkdir -p "$logs"
sb=$top/root.$$
sandbox "$sb"

one() {
	s=$1
	# the run's own /tmp: the applications keep their files for
	# Veltro in /tmp/veltro, which runs at once would share
	r=$sb/tmp/wm-fuzz/r$s
	rm -rf "${r:?}"
	mkdir -p "$r/tmp/files"
	f=/tmp/files
	for i in 1 2 3; do
		seq 1 60 | sed "s/^/f$i line /" > "$r/tmp/files/f$i"
	done
	seq 1 3000 | sed 's/^/a longer file, line /' > "$r/tmp/files/fbig"
	start="wm/editor $f/f1"
	[ $app = shell ] && start="cd $f; wm/shell"
	cat > "$r/tmp/run" <<EOF
load std
$start &
sleep 4
/dis/tests/wmfuzz.dis -a $app -s $s -t $secs -d $f >[2=1]
EOF
	log=$logs/$app-$s.log
	SDL_VIDEODRIVER=dummy with_timeout $((secs+120)) "$EMU" $flag -pheap=512m -pmain=512m -pimage=512m \
		-g1000x800 -r"$sb" /dis/sh.dis -c "bind -c /tmp/wm-fuzz/r$s/tmp /tmp; wm/wm sh /tmp/run" </dev/null > "$log" 2>&1
	bad=$(grep -E '^fuzz: (HUNG|BROKEN|STUCK|DATA|NO WINDOW)' "$log" | head -4)
	if [ -z "$bad" ] && ! grep -q '^fuzz: \(INTEGRITY ok\|EXITED\)' "$log"; then
		bad="no outcome: $(grep -v '^fs: fsqid' "$log" | tail -2 | tr '\n' ' ')"
	fi
	if [ -n "$bad" ]; then
		mapstacks "$log" > "$log.map" && mv "$log.map" "$log"
		echo "$app seed $s: FAIL"; printf '%s\n' "$bad" | sed 's/^/	/'
		return 1
	fi
	echo "$app seed $s: ok$(grep -q '^fuzz: EXITED' "$log" && echo ' (exited by its menu)')$(sed -n 's/^fuzz: (\([0-9]*\) new shells started.*/ (\1 new shells started)/p' "$log")"
	[ $keep = 1 ] || rm -rf "${r:?}" "${log:?}"
	return 0
}

failed=0
pids=
for i in $(seq 0 $((runs - 1))); do
	one $((seed + i)) &
	pids="$pids $!"
	while [ "$(jobs -rp | wc -l)" -ge "$jobs" ]; do sleep 1; done
done
for p in $pids; do
	wait $p || failed=$((failed + 1))
done
echo "wm-fuzz: $app, $runs runs, $failed failed (logs in $logs)"
[ $failed = 0 ] && [ $keep = 0 ] && rm -rf "${sb:?}"
[ $failed = 0 ]
