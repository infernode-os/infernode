#!/bin/sh
# xen — open host files in a standalone InferNode editor, Acme-SAC style.
#
#	xen [-s] [-w] [file ...]
#
# Starts an emu that runs nothing but the editor: no Lucifer, no login.
# The emu window is the editor, and leaving the editor halts the emu.
#
#	Xenith (default) runs with no window manager, so it is Plain over
#	the whole emu window and its Exit halts the emu itself
#	(appl/xenith/gui.b, killwins).
#
#	sam (-s) is Tk and needs a window manager: it runs under wm/wm,
#	and the emu is halted when sam returns (q, or exit on the
#	command window's menu).
#
# Host paths are reached through /n/local, which the profile mounts over
# the host root; the editor starts in the caller's directory.
#
# By default xen returns at once and the editor runs detached. -w waits
# for the editor to finish instead, so xen can serve as $EDITOR
# (EDITOR='xen -w') or be awaited by a script.
#
# Environment:
#	INFERNODE_ROOT	tree to run (default: the tree holding this script)
#	XEN_THEME	the session's theme (default xenith): any installed theme
#			(/lib/lucifer/theme); glenda (or plan9) is Plan 9's acme. Xenith's
#			Theme command switches it, for this session only.
#			sam takes its colours from the system theme.
#	XEN_GEOM	initial emu window size (default 1400x900)
#	XEN_LOG		where a detached emu's output goes (default $TMPDIR/xen.log)

usage() {
	echo "usage: xen [-s] [-w] [file ...]" >&2
	exit 2
}

editor=xenith
wait=0
while getopts sw c; do
	case $c in
	s)	editor=sam ;;
	w)	wait=1 ;;
	*)	usage ;;
	esac
done
shift $((OPTIND - 1))

# Find the tree through any symlink (e.g. ~/bin/xen -> .../tools/xen).
self=$0
while [ -L "$self" ]; do
	link=$(readlink "$self")
	case $link in
	/*)	self=$link ;;
	*)	self=$(dirname "$self")/$link ;;
	esac
done
root=${INFERNODE_ROOT:-$(cd "$(dirname "$self")/.." && pwd)}
case $(uname -s) in
Darwin)	emu=$root/emu/MacOSX/o.emu ;;
Linux)	emu=$root/emu/Linux/o.emu ;;
*)	echo "xen: unsupported host $(uname -s); on Windows use tools/xen.ps1" >&2; exit 1 ;;
esac
if [ ! -x "$emu" ]; then
	echo "xen: no emulator at $emu (build one first)" >&2
	exit 1
fi
# A headless emu runs the editor on an offscreen display and shows no
# window at all. Refuse it, when the binary still has symbols to tell.
syms=$(nm "$emu" 2>/dev/null)
if [ -n "$syms" ] && ! printf '%s\n' "$syms" | grep -q sdl3_mainloop; then
	echo "xen: $emu is a headless build and cannot open a window;" >&2
	echo "xen: build the GUI emulator (./build-macos-sdl3.sh or ./build-linux-*.sh) in $root" >&2
	exit 1
fi

# Quote for the Inferno shell: wrap in '' and double any embedded '.
q() {
	printf "'%s'" "$(printf '%s' "$1" | sed "s/'/''/g")"
}

files=
for f in "$@"; do
	case $f in
	/*)	;;
	*)	f=$PWD/$f ;;
	esac
	files="$files $(q "/n/local$f")"
done

case $editor in
xenith)
	# A plumber first, as Lucifer's boot starts one, so plumbing works
	# from the outset and Xenith does not have to start its own.
	run="bind -bc '#splumber' /chan; plumber /lib/xen/plumbing; "
	# With plan9port present, listen on its plumber's xenith port too
	# (tools/xen.plumbing), so `plumb file` on the host opens the file
	# here. The host shell kills its reader once the emu is gone.
	if nine=$(command -v 9p); then
		host="'$nine' read plumb/xenith & r=\$!; while kill -0 \$PPID 2>/dev/null; do sleep 1; done; kill \$r"
		run="${run}os sh -c $(q "$host") | hostplumb & "
	fi
	run="${run}xenith -t $(q "${XEN_THEME:-xenith}")$files" ;;
sam)
	run="wm/wm sh -c $(q "wm/sam$files; echo halt > /dev/sysctl")" ;;
esac
cmd="cd $(q "/n/local$PWD"); $run"

set -- "$emu" -c1 -pheap=512m -pmain=512m -pimage=512m \
	-g"${XEN_GEOM:-1400x900}" -r"$root" /dis/sh.dis -l -c "$cmd"
if [ $wait = 1 ]; then
	exec "$@"
fi
nohup "$@" </dev/null >"${XEN_LOG:-${TMPDIR:-/tmp}/xen.log}" 2>&1 &
